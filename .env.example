# Copy to .env (uv loads it automatically). Real values stay out of git.
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# Optional: film ratings. OMDb (1,000 requests/day) returns IMDb and
# Metacritic scores; it no longer returns Rotten Tomatoes data, so the
# Tomatometer comes from RT's public search/pages via `ratings --scrape-rt-mc`.
# Get a key at https://www.omdbapi.com/apikey.aspx and uncomment:
# OMDB_API_KEY=xxxxxxxx

# Optional: TMDB v3 key, used only as a title/year matching aid if OMDb misses.
# TMDB_API_KEY=xxxxxxxx
