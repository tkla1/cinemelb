# Copy to .env (uv loads it automatically). Real values stay out of git.
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# Optional: film ratings. OMDb is the only free key that returns IMDb, Rotten
# Tomatoes and Metacritic scores in one request (1,000 requests/day).
# Get one at https://www.omdbapi.com/apikey.aspx and uncomment:
# OMDB_API_KEY=xxxxxxxx

# Optional: TMDB v3 key, used only as a title/year matching aid if OMDb misses.
# TMDB_API_KEY=xxxxxxxx
